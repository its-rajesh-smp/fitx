NODE_ENV=development
PORT=8080

# Use DATABASE_URL or POSTGRES_URL in production. The individual values are
# convenient for the local Docker Postgres service.
DATABASE_URL=
POSTGRES_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fitx
POSTGRES_POOL_MAX=5

BCRYPT_SALT_ROUNDS=10
JWT_SECRET=replace-with-a-long-random-secret

AI_PROVIDER=gemini # gemini | openai | anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MEMORY_MODEL=gpt-4.1-nano
OPENAI_AGENTS_TRACING_ENABLED=false

# Used when AI_PROVIDER=anthropic (chat, memory and summary agents all use Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MEMORY_MODEL=claude-haiku-5-5

# Used to find embeddable exercise guides from YouTube Data API v3.
YOUTUBE_API_KEY=

# OAuth 2.0 Web client ID used to verify Google sign-in tokens
GOOGLE_CLIENT_ID=
